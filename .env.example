APP_ENV=dev
APP_DEBUG=true
# Optional: JSON method trace file (default in APP_DEBUG: logs/method-trace.jsonl)
# DENARIUS_METHOD_LOG=logs/method-trace.jsonl
# IDP HTTP wire log (requires APP_DEBUG). Set PLAINTEXT=false to redact Authorization in logs.
# DENARIUS_IDP_HTTP_LOG=true
# DENARIUS_IDP_HTTP_LOG_PLAINTEXT=true
APP_KEY=change-me-to-a-long-random-string

DB_HOST=amtgard-denarius-db
DB_PORT=3306
DB_NAME=denarius
# PHPUnit uses denarius_test on the same MariaDB host (see phpunit.xml). Never run migrateFresh tests against DB_NAME=denarius.
DB_USER=denarius
DB_PASS=secret

SESSION_REDIS_HOST=amtgard-denarius-sessions
SESSION_REDIS_PORT=6379
REDIS_HOST=amtgard-denarius-sessions
REDIS_PORT=6379
REDIS_DB=0
SESSION_REDIS_DB=1

IDP_BASE_URL=https://idp.amtgard.com
IDP_CLIENT_ID=
IDP_CLIENT_SECRET=
IDP_REDIRECT_URI=https://denarius.amtgard.com/oauth/callback
IDP_IAM_SERVICE=Denarius
IDP_IAM_SERVICE_FORMAT=["Configuration","Kingdom"]

# Comma-separated IDP userinfo id values (UUID strings on production IDP).
DENARIUS_BOOTSTRAP_ADMIN_IDP_USER_IDS=

# ORK GetKingdoms: server fetch when cache empty; falls back to data/ork-kingdoms.bundled.json (Cloudflare often blocks server curl).
# Admin UI also posts browser-fetched ORK JSON to /admin/kingdoms/sync for a full live directory.
ORK_KINGDOMS_CACHE=data/ork-kingdoms.json
ORK_API_BASE_URL=https://ork.amtgard.com
ORK_API_USER_AGENT=Amtgard-Denarius
ORK_API_REFERER=https://denarius.amtgard.com

# Shared taxonomy pack (keywords, provider hints, category labels).
TAXONOMY_DATA_PATH=data/taxonomy

TELLER_APPLICATION_ID=
TELLER_ENVIRONMENT=sandbox
TELLER_API_BASE=https://api.teller.io
TELLER_CERT_PATH=/var/www/denarius.amtgard.com/keys/teller.pem
TELLER_KEY_PATH=/var/www/denarius.amtgard.com/keys/teller.key
TELLER_WEBHOOK_SECRET=

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE=https://api.stripe.com

PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_CLIENT_NAME=Denarius
PLAID_API_BASE=https://sandbox.plaid.com

# SimpleFIN Bridge app (Apps section — one app per Denarius environment, not per kingdom).
SIMPLEFIN_APP_ID=
SIMPLEFIN_APP_TOKEN=
# Optional: override bridge root (default https://bridge.simplefin.org/simplefin).
# Do not point this at beta-bridge — /apps/{appId}/create is not served there.
# SIMPLEFIN_BRIDGE_ROOT=
# Public site URL for SimpleFIN return links (defaults from IDP_REDIRECT_URI origin).
# APP_PUBLIC_URL=http://localhost:37180
