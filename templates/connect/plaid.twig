<button type="button" id="plaid-connect" class="btn btn-primary">Connect with Plaid</button>
<script src="https://cdn.plaid.com/link/v2/stable/link-initialize.js"></script>
<script>
var plaid = Plaid.create({
    token: {{ connect.config.linkToken|json_encode|raw }},
    onSuccess: function (publicToken) {
        denariusEnrollment({ publicToken: publicToken });
    }
});
document.getElementById('plaid-connect').addEventListener('click', function () {
    plaid.open();
});
</script>
