{% extends "base.twig" %}
{% import "macros.twig" as ui %}

{% block title %}Pattern — {{ kingdom.name }}{% endblock %}
{% block container_class %}container-md{% endblock %}

{% block content %}
{% embed 'components/page-header.twig' with { title: ruleId ? 'Edit pattern' : 'Create pattern' } %}
    {% block header_actions %}
        <a class="btn btn-outline-secondary btn-sm" href="/manage/{{ kingdom.slug }}?tab=patterns">Back to patterns</a>
    {% endblock %}
{% endembed %}

<form method="post" action="{{ formAction }}">
    <input type="hidden" name="csrf" value="{{ csrf }}">
    {% include 'components/pattern-form-fields.twig' with {
        prefill: prefill,
        categoryMode: 'typeahead',
        categoryFlow: 'expense',
        categorySearchUrl: '/manage/' ~ kingdom.slug ~ '/taxonomy/categories',
        tokenGlobHelp: true,
        hideTokenHelp: true
    } %}
    {{ ui.submit('Save pattern') }}
</form>
{% endblock %}

{% block scripts %}
<script src="/js/category-typeahead.js"></script>
{% endblock %}
