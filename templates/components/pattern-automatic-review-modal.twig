<div class="modal fade" id="pattern-automatic-review-modal" tabindex="-1" aria-labelledby="pattern-automatic-review-title" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <form method="post" action="/manage/{{ kingdom.slug }}/pattern-revisions/apply" id="pattern-automatic-review-form">
                <input type="hidden" name="csrf" value="{{ csrf }}">
                <input type="hidden" name="review_month" value="{{ reviewMonth }}">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="pattern-automatic-review-title">Review matched patterns</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-body-secondary mb-3">
                        These {{ reviewMonth }} rows would get a new stored category from your pattern rules when you apply.
                        Manager-set categories are not listed. You can edit any row afterward in the worksheet.
                    </p>
                    <div id="pattern-automatic-review-scroll" class="border rounded" tabindex="0" aria-label="Pattern rule bulk apply" style="max-height: 320px; overflow-x: auto; overflow-y: scroll; -webkit-overflow-scrolling: touch;">
                        <table class="table table-sm table-striped mb-0">
                            <thead class="table-light" style="position: sticky; top: 0; z-index: 2;">
                                <tr>
                                    <th scope="col" class="text-center" style="width: 2.5rem;">
                                        <input class="form-check-input" type="checkbox" id="pattern-automatic-select-all" checked aria-label="Select all rows">
                                    </th>
                                    <th scope="col">Posted</th>
                                    <th scope="col">Description</th>
                                    <th scope="col">Counterparty</th>
                                    <th scope="col">Amount</th>
                                    <th scope="col">Stored category</th>
                                    <th scope="col">After apply</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for row in patternAutomaticCandidates %}
                                    <tr>
                                        <td class="text-center">
                                            <input class="form-check-input pattern-automatic-apply" type="checkbox" name="apply_transaction_ids[]" value="{{ row.tellerTransactionId }}" checked aria-label="Apply pattern category to this row">
                                        </td>
                                        <td>{{ row.postedOn }}</td>
                                        <td>{{ row.description }}</td>
                                        <td>{{ row.counterparty }}</td>
                                        <td>{{ row.amount }}</td>
                                        <td>{{ row.currentDisplay }}</td>
                                        <td>{{ row.suggestedDisplay }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm">Apply</button>
                </div>
            </form>
        </div>
    </div>
</div>
