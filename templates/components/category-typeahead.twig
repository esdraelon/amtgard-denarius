{# CategoryTypeahead: closed category id picker with flow + label. #}
<div class="category-typeahead position-relative" data-category-typeahead data-category-id="{{ selectedCategoryId }}" data-flow="{{ flow }}" data-search-url="{{ searchUrl }}">
    <label class="form-label visually-hidden" for="{{ inputId }}">Category</label>
    <div class="category-typeahead-input-wrap position-relative">
        <input type="text"
               class="form-control form-control-sm category-typeahead-input"
               id="{{ inputId }}"
               name="{{ inputName }}"
               value="{{ displayValue }}"
               autocomplete="off"
               data-typeahead-input
               aria-expanded="false"
               aria-controls="{{ listId }}"
               role="combobox"
               {% if placeholder|default('') != '' %}placeholder="{{ placeholder }}"{% endif %}>
        <span class="category-typeahead-save-indicator" aria-hidden="true"></span>
    </div>
    <input type="hidden" name="{{ hiddenName|default('category_id') }}" value="{{ selectedCategoryId }}" data-typeahead-id>
    <ul class="list-group position-absolute w-100 shadow-sm d-none z-3"
        id="{{ listId }}"
        data-typeahead-list
        role="listbox"
        style="max-height: 12rem; overflow-y: auto;"></ul>
</div>
