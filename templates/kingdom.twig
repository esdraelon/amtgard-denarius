{% extends "base.twig" %}
{% block title %}{{ kingdom.name }}{% endblock %}
{% block body %}
<h1>{{ kingdom.name }}</h1>
<p>
    <a href="/{{ kingdom.slug }}?month={{ previous }}">Previous month</a>
    {{ month }}
    <a href="/{{ kingdom.slug }}?month={{ next }}">Next month</a>
</p>
{% if disconnected %}<p>The bank connection needs to be repaired.</p>{% endif %}
{% if syncedAt %}<p>Last synced {{ syncedAt }}.</p>{% endif %}
{% if rows is empty %}
    <p>No transactions for this month.</p>
{% elseif mode == 'summarized' %}
    <table>
        <thead><tr><th>Category</th><th>Transactions</th><th>Amount</th></tr></thead>
        <tbody>
        {% for row in rows %}
            <tr><td>{{ row.category }}</td><td>{{ row.count }}</td><td>{{ row.amount }}</td></tr>
        {% endfor %}
        </tbody>
    </table>
{% elseif mode == 'redacted' %}
    <table>
        <thead><tr><th>Date</th><th>Category</th><th>Amount</th></tr></thead>
        <tbody>
        {% for row in rows %}
            <tr><td>{{ row.postedOn }}</td><td>{{ row.category }}</td><td>{{ row.amount }}</td></tr>
        {% endfor %}
        </tbody>
    </table>
{% else %}
    <table>
        <thead><tr><th>Date</th><th>Account</th><th>Category</th><th>Counterparty</th><th>Description</th><th>Amount</th></tr></thead>
        <tbody>
        {% for row in rows %}
            <tr>
                <td>{{ row.postedOn }}</td>
                <td>{{ row.account }}</td>
                <td>{{ row.category }}</td>
                <td>{{ row.counterparty }}</td>
                <td>{{ row.description }}</td>
                <td>{{ row.amount }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endif %}
{% endblock %}
