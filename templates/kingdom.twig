{% extends "base.twig" %}
{% import "macros.twig" as ui %}

{% block title %}{{ kingdom.name }}{% endblock %}
{% block container_class %}container-xl{% endblock %}

{% block content %}
{% embed 'components/page-header.twig' with { title: kingdom.name } %}
    {% import "macros.twig" as ui %}
    {% block header_meta %}
        <div class="d-flex flex-wrap align-items-center gap-2 small text-body-secondary mb-2">
            {{ ui.btn_secondary('Previous month', '/' ~ kingdom.slug ~ '?month=' ~ previous) }}
            <span class="fw-semibold text-denarius-tertiary">{{ month }}</span>
            {{ ui.btn_secondary('Next month', '/' ~ kingdom.slug ~ '?month=' ~ next) }}
        </div>
        {% if disconnected %}
            {% include 'components/alert.twig' with {
                variant: 'warning',
                message: 'The bank connection needs to be repaired.'
            } %}
        {% endif %}
        {% if syncedAt %}
            <p class="small text-body-secondary mb-0">Last synced {{ syncedAt }}.</p>
        {% endif %}
    {% endblock %}
{% endembed %}

{% if rows is empty %}
    {% if absenceMessage %}
        {% include 'components/alert.twig' with { variant: 'info', message: absenceMessage } %}
    {% else %}
        <p class="text-body-secondary">No transactions for this month.</p>
    {% endif %}
{% elseif mode == 'summarized' %}
    {% include 'components/data-table.twig' with {
        columns: ['Section', 'Category', 'Transactions', 'Amount'],
        fields: ['flowSection', 'category', 'count', 'amount'],
        rows: rows,
        empty_message: 'No transactions for this month.'
    } %}
{% elseif mode == 'redacted' %}
    {% include 'components/data-table.twig' with {
        columns: ['Date', 'Category', 'Amount'],
        fields: ['postedOn', 'category', 'amount'],
        rows: rows,
        empty_message: 'No transactions for this month.'
    } %}
{% else %}
    {% include 'components/data-table.twig' with {
        columns: ['Date', 'Account', 'Category', 'Counterparty', 'Description', 'Amount'],
        fields: ['postedOn', 'account', 'category', 'counterparty', 'description', 'amount'],
        rows: rows,
        empty_message: 'No transactions for this month.'
    } %}
{% endif %}
<p class="small text-body-secondary mt-3 mb-0">
    Categories use the shared kingdom taxonomy (closed labels only—never raw bank categories). Amounts are rounded for public disclosure. Small categories may roll into an “Other” bucket; transfers are shown separately and excluded from net. Sensitive verification activity is withheld from this view; kingdom treasurers reconcile those items in the bank portal.
</p>
{% endblock %}
