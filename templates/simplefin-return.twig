{% extends "base.twig" %}
{% import "macros.twig" as ui %}

{% block title %}SimpleFIN connection{% endblock %}
{% block container_class %}max-w-lg{% endblock %}

{% block content %}
<h1 class="text-2xl font-serif font-bold text-secondary mb-4">Finish SimpleFIN connection</h1>
{% if error %}
    <p class="mb-4 text-sm text-amber-800">{{ error }}</p>
{% else %}
    <p class="mb-4 text-sm text-gray-700">If SimpleFIN sent you back here without connecting automatically, paste the setup token from the bridge below.</p>
{% endif %}
<form method="post" action="/bank/simplefin/return">
    <input type="hidden" name="csrf" value="{{ csrf }}">
    <label class="block mb-3 text-sm font-semibold text-tertiary">Setup token
        <textarea name="setup_token" required class="mt-1 block w-full border border-gray-300 rounded px-3 py-2 font-normal font-mono text-sm" rows="4"></textarea>
    </label>
    {{ ui.submit('Connect kingdom') }}
</form>
{% endblock %}
