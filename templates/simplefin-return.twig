{% extends "base.twig" %}
{% import "macros.twig" as ui %}

{% block title %}SimpleFIN connection{% endblock %}
{% block container_class %}container-sm{% endblock %}

{% block content %}
<h1 class="font-serif h3 text-denarius-secondary mb-4">Finish SimpleFIN connection</h1>
{% if error %}
    <div class="alert alert-warning">{{ error }}</div>
{% else %}
    <p class="mb-4 small text-body-secondary">If SimpleFIN sent you back here without connecting automatically, paste the setup token from the bridge below.</p>
{% endif %}
<form method="post" action="/bank/simplefin/return">
    <input type="hidden" name="csrf" value="{{ csrf }}">
    <div class="mb-3">
        <label class="form-label fw-semibold text-denarius-tertiary" for="setup_token">Setup token</label>
        <textarea name="setup_token" id="setup_token" required class="form-control font-monospace small" rows="4"></textarea>
    </div>
    {{ ui.submit('Connect kingdom') }}
</form>
{% endblock %}
