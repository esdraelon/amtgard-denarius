{# Matches ORK default login OAuth control (Login_index.tpl). #}
{% macro btn_login_with_amtgard(href) %}
    <a href="{{ href }}" class="login-with-amtgard inline-flex w-full max-w-md items-center justify-center rounded border border-gray-300 bg-white px-3 py-2.5 text-sm font-medium text-gray-800 no-underline whitespace-nowrap transition-colors hover:bg-gray-50 hover:border-gray-400">
        Login with Amtgard
        <img src="https://ork.amtgard.com/assets/images/amtgard_idp_favicon.png" alt="" width="32" height="32" class="ml-2.5 h-8 w-8 shrink-0">
    </a>
{% endmacro %}

{% macro btn_primary(label, href) %}
    <a href="{{ href }}" class="inline-block bg-primary hover:bg-primary-dark text-white py-2 px-5 rounded no-underline transition-colors duration-200">{{ label }}</a>
{% endmacro %}

{% macro btn_secondary(label, href) %}
    <a href="{{ href }}" class="inline-block border border-gray-400 hover:border-gray-600 text-gray-700 hover:text-gray-900 py-2 px-5 rounded no-underline transition-colors duration-200 font-semibold text-sm">{{ label }}</a>
{% endmacro %}

{% macro submit(label) %}
    <button type="submit" class="bg-primary hover:bg-primary-dark text-white py-2 px-5 rounded transition-colors duration-200 cursor-pointer border-0">{{ label }}</button>
{% endmacro %}

{% macro input_text(name, value, label) %}
    <label class="block mb-3 text-sm font-semibold text-tertiary">{{ label }}
        <input name="{{ name }}" value="{{ value }}" class="mt-1 block w-full border border-gray-300 rounded px-3 py-2 font-normal">
    </label>
{% endmacro %}
