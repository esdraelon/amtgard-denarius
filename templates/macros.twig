{# Matches ORK default login OAuth control (Login_index.tpl). #}
{% macro btn_login_with_amtgard(href) %}
    <a href="{{ href }}" class="login-with-amtgard btn btn-outline-secondary d-inline-flex align-items-center justify-content-center w-100 text-decoration-none" style="max-width: 28rem;">
        Login with Amtgard
        <img src="https://ork.amtgard.com/assets/images/amtgard_idp_favicon.png" alt="" width="32" height="32" class="ms-2">
    </a>
{% endmacro %}

{% macro btn_primary(label, href) %}
    <a href="{{ href }}" class="btn btn-primary">{{ label }}</a>
{% endmacro %}

{% macro btn_secondary(label, href) %}
    <a href="{{ href }}" class="btn btn-outline-secondary btn-sm fw-semibold">{{ label }}</a>
{% endmacro %}

{% macro submit(label) %}
    <button type="submit" class="btn btn-primary">{{ label }}</button>
{% endmacro %}

{% macro input_text(name, value, label) %}
    <div class="mb-3">
        <label class="form-label fw-semibold text-denarius-tertiary" for="{{ name }}">{{ label }}</label>
        <input name="{{ name }}" id="{{ name }}" value="{{ value }}" class="form-control">
    </div>
{% endmacro %}
