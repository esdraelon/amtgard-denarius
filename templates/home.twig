{% extends "base.twig" %}

{% block title %}Denarius{% endblock %}
{% block container_class %}container{% endblock %}

{% block content %}
    {% embed "partials/brand.twig" %}
        {% import "macros.twig" as ui %}
        {% block brand_inner %}
            <h1 class="font-serif display-6 text-denarius-secondary mb-3">
                <a href="/" class="text-denarius-secondary text-decoration-none">Denarius</a>
            </h1>
            <p class="mb-4 text-body-secondary">
                Amtgard kingdom treasuries published for accountability. Kingdom bank statements, shared with the community you serve.
            </p>

            {% embed "components/section-card.twig" with { title: authenticated ? 'Account' : 'Sign in' } %}
                {% import "macros.twig" as ui %}
                {% block section_body %}
                    {% if authenticated %}
                        <p class="mb-3">You are signed in with Amtgard ID.</p>
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            {% for action in accountActions %}
                                {{ ui.btn_primary(action.label, action.href) }}
                            {% endfor %}
                            {{ ui.btn_secondary('Log out', '/logout') }}
                        </div>
                        {% if accountActions is empty %}
                            <p class="small text-body-secondary mb-0">No Denarius admin or kingdom manager roles are loaded for this account. If access was just granted, log out and sign in again so Denarius can refresh your IdP permissions.</p>
                        {% endif %}
                    {% else %}
                        <p class="mb-3">Use your Amtgard ID to manage kingdoms or view restricted statements.</p>
                        <div class="mb-2">
                            {{ ui.btn_login_with_amtgard('/login') }}
                        </div>
                    {% endif %}
                {% endblock %}
            {% endembed %}

            {% embed "components/section-card.twig" with { title: 'Kingdom statements' } %}
                {% import "macros.twig" as ui %}
                {% block section_body %}
                    {% if kingdomLinks is empty %}
                        <p class="mb-0 text-body-secondary">No ORK kingdom directory is loaded yet. Denarius reads the bundled snapshot and refreshes from ORK automatically.</p>
                    {% else %}
                        <ul class="list-unstyled mb-0 vstack gap-2">
                            {% for kingdom in kingdomLinks %}
                                <li>
                                    {% if kingdom.href %}
                                        <a href="{{ kingdom.href }}">{{ kingdom.name }}</a>
                                    {% else %}
                                        {{ kingdom.name }}
                                        <span class="text-body-secondary small">(statement not published on Denarius yet)</span>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                {% endblock %}
            {% endembed %}

            {% embed "components/section-card.twig" with { title: 'About' } %}
                {% block section_body %}
                    <p class="mb-0 text-body-secondary">Denarius connects kingdom bank accounts through approved providers and publishes monthly statements according to each kingdom&apos;s visibility settings.</p>
                {% endblock %}
            {% endembed %}
        {% endblock %}
    {% endembed %}
{% endblock %}
