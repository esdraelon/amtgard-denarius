{% import "macros.twig" as ui %}

{% embed 'components/section-card.twig' with {
    title: 'Statement settings',
    help_id: 'manage-help-statement-settings',
    help_content: '<p class=\"mb-2\"><strong>Visibility</strong> controls who may open the kingdom page. <strong>Disclosure tier</strong> controls what members see after the publication pipeline runs.</p><ul class=\"mb-2 ps-3\"><li><strong>Summarized</strong> — category totals by income, expense, and transfer (net excludes transfers); sparse buckets may roll up per kingdom settings.</li><li><strong>Redacted</strong> — dated lines with taxonomy labels and <em>quantized</em> amounts (no description or counterparty).</li><li><strong>Less redacted</strong> — adds account name and limited narrative fields; amounts stay quantized; verification and payroll-style rows may be further scrubbed.</li></ul><p class=\"mb-0\">Public paths never show raw bank cents or provider category hints—only closed taxonomy labels after the publication pipeline. Managers review and publish in the queue before rows appear on the public statement.</p>'
} %}
    {% import "macros.twig" as ui %}
    {% block section_body %}
        <form method="post" action="/manage/{{ kingdom.slug }}/settings">
            <input type="hidden" name="csrf" value="{{ csrf }}">
            {% include 'components/form-field-select.twig' with {
                name: 'visibility',
                label: 'Visibility',
                options: ['public', 'registered', 'kingdom_only'],
                selected: kingdom.visibility,
                max_width: '28rem'
            } %}
            {% include 'components/form-field-select.twig' with {
                name: 'display_mode',
                label: 'Public disclosure tier',
                options: ['less_redacted', 'redacted', 'summarized'],
                selected: kingdom.displayMode == 'all' ? 'less_redacted' : kingdom.displayMode,
                max_width: '28rem'
            } %}
            {% include 'components/form-field-select.twig' with {
                name: 'embargo_days',
                label: 'Publication embargo (days after posted date)',
                options: ['1', '2', '3', '4', '5', '6', '7'],
                selected: kingdom.embargoDays ~ '',
                max_width: '28rem'
            } %}
            {{ ui.submit('Save') }}
        </form>
        <p class="mt-3 small text-body-secondary mb-0">Enrollment status: <span class="fw-semibold">{{ kingdom.enrollmentStatus }}</span></p>
        {% if kingdom.enrollmentStatus == 'disconnected' %}
            {% include 'components/alert.twig' with {
                variant: 'warning',
                message: 'Bank access was disconnected. Use Add bank below to connect again.'
            } %}
        {% endif %}
    {% endblock %}
{% endembed %}

{% embed 'components/section-card.twig' with {
    title: 'Bank connection',
    help_id: 'manage-help-bank-connection',
    help_content: '<p class=\"mb-0\">Disconnect removes Denarius copies of accounts and transactions so you can connect again. This does not close the link at your bank or payment provider; revoke access there if needed.</p>'
} %}
    {% import "macros.twig" as ui %}
    {% block section_body %}
        {% if kingdom.enrollmentStatus == 'connected' %}
            <p class="mb-3">
                Connected{% if kingdom.institutionName %} to <span class="fw-semibold">{{ kingdom.institutionName }}</span>{% endif %}{% if kingdom.provider %} via {{ kingdom.provider }}{% endif %}.
            </p>
            <form method="post" action="/manage/{{ kingdom.slug }}/disconnect" class="mb-0">
                <input type="hidden" name="csrf" value="{{ csrf }}">
                <button type="submit" class="btn btn-outline-danger btn-sm">Disconnect bank</button>
            </form>
        {% elseif not connect.available %}
            <form method="post" action="/manage/{{ kingdom.slug }}/connect">
                <input type="hidden" name="csrf" value="{{ csrf }}">
                {% for id in connect.skipped %}
                    <input type="hidden" name="skipped[]" value="{{ id }}">
                {% endfor %}
                {{ ui.submit('Add bank') }}
            </form>
            {% if connect.reason == 'exhausted' %}
                {% include 'components/alert.twig' with {
                    variant: 'warning',
                    message: 'No configured provider is available. Contact the Denarius administrator.'
                } %}
            {% endif %}
        {% else %}
            <div class="vstack gap-2">
                {% include 'connect/' ~ connect.provider ~ '.twig' %}
            </div>
            <form method="post" action="/manage/{{ kingdom.slug }}/connect" class="mt-3">
                <input type="hidden" name="csrf" value="{{ csrf }}">
                {% for id in connect.skipped %}
                    <input type="hidden" name="skipped[]" value="{{ id }}">
                {% endfor %}
                <input type="hidden" name="current" value="{{ connect.provider }}">
                <button type="submit" name="skip" value="1" class="btn btn-outline-secondary btn-sm">Try another provider</button>
            </form>
        {% endif %}
    {% endblock %}
{% endembed %}

{% embed 'components/section-card.twig' with { title: 'Published accounts' } %}
    {% import "macros.twig" as ui %}
    {% block section_body %}
        <form method="post" action="/manage/{{ kingdom.slug }}/accounts">
            <input type="hidden" name="csrf" value="{{ csrf }}">
            <div class="vstack gap-2 mb-3">
            {% for account in accounts %}
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="published[]" value="{{ account.tellerAccountId }}" id="pub-{{ account.tellerAccountId }}" {% if account.published %}checked{% endif %}>
                    <label class="form-check-label" for="pub-{{ account.tellerAccountId }}">
                        {{ account.name }} ({{ account.type }})
                    </label>
                </div>
            {% endfor %}
            </div>
            {{ ui.submit('Save accounts') }}
        </form>
    {% endblock %}
{% endembed %}

<form id="enrollment-form" method="post" action="/manage/{{ kingdom.slug }}/enrollment" class="d-none">
    <input type="hidden" name="csrf" value="{{ csrf }}">
    <input type="hidden" name="enrollment" id="enrollment-json">
</form>
