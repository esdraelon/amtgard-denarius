{% import "macros.twig" as ui %}

<p class="small text-body-secondary">Kingdom-only rules match normalized description and counterparty text. They override shared keywords and never appear on public statements. Saving runs a recategorize pass for non-manager rows.</p>

<p class="mb-3">
    <a class="btn btn-primary btn-sm" href="/manage/{{ kingdom.slug }}/patterns/new">New pattern</a>
</p>

{% embed 'components/section-card.twig' with { title: 'Patterns' } %}
    {% block section_body %}
        {% set patterns = patterns|default([]) %}
        {% if patterns is empty %}
            {% include 'components/alert.twig' with {
                variant: 'info',
                message: 'No patterns yet. Create one from review or add a new pattern.'
            } %}
        {% else %}
            <form method="post" action="/manage/{{ kingdom.slug }}/patterns/bulk">
                <input type="hidden" name="csrf" value="{{ csrf }}">
                <div class="table-responsive">
                    <table class="table table-sm table-bordered align-middle mb-3">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">Rule</th>
                                <th scope="col">Match</th>
                                <th scope="col" style="min-width: 14rem;">Category</th>
                                <th scope="col"></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for row in patterns %}
                                <tr>
                                    <td class="small text-body-secondary">{{ row.ruleId }}</td>
                                    <td>
                                        <input type="hidden" name="patterns[{{ row.id }}][match_type]" value="{{ row.matchType }}">
                                        {% if row.matchType == 'regex' %}
                                            <input class="form-control form-control-sm" name="patterns[{{ row.id }}][regex_pattern]" value="{{ row.regexPattern }}">
                                        {% elseif row.matchType == 'anyOf' %}
                                            <input class="form-control form-control-sm" name="patterns[{{ row.id }}][any_of]" value="{{ row.anyOfTokens }}">
                                        {% else %}
                                            <input class="form-control form-control-sm" name="patterns[{{ row.id }}][token]" value="{{ row.token }}">
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% include 'components/category-typeahead.twig' with {
                                            inputId: 'pattern-cat-' ~ row.id,
                                            listId: 'pattern-cat-list-' ~ row.id,
                                            inputName: 'patterns[' ~ row.id ~ '][category_display]',
                                            hiddenName: 'patterns[' ~ row.id ~ '][category_id]',
                                            selectedCategoryId: row.categoryId,
                                            displayValue: row.categoryDisplay,
                                            flow: row.categoryFlow,
                                            searchUrl: '/manage/' ~ kingdom.slug ~ '/taxonomy/categories'
                                        } %}
                                    </td>
                                    <td class="text-nowrap">
                                        <a class="btn btn-outline-secondary btn-sm" href="/manage/{{ kingdom.slug }}/patterns/new?category={{ row.category|url_encode }}">Duplicate</a>
                                        <button type="submit" class="btn btn-outline-danger btn-sm" formaction="/manage/{{ kingdom.slug }}/patterns/{{ row.id }}/delete">Delete</button>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {{ ui.submit('Save bulk edits') }}
            </form>
        {% endif %}
    {% endblock %}
{% endembed %}
