{% extends "base.twig" %}
{% import "macros.twig" as ui %}

{% block title %}Manage {{ kingdom.name }}{% endblock %}
{% block container_class %}container-lg{% endblock %}

{% block content %}
{% embed 'components/page-header.twig' with { title: 'Manage ' ~ kingdom.name } %}
    {% import "macros.twig" as ui %}
    {% block header_actions %}
        <p class="mb-0">{{ ui.btn_secondary('Public statement', '/' ~ kingdom.slug) }}</p>
    {% endblock %}
{% endembed %}

{% embed 'components/section-card.twig' with { title: 'Statement settings' } %}
    {% import "macros.twig" as ui %}
    {% block section_body %}
        <form method="post" action="/manage/{{ kingdom.slug }}/settings">
            <input type="hidden" name="csrf" value="{{ csrf }}">
            {% include 'components/form-field-select.twig' with {
                name: 'visibility',
                label: 'Visibility',
                options: ['public', 'registered', 'kingdom_only'],
                selected: kingdom.visibility,
                max_width: '28rem'
            } %}
            {% include 'components/form-field-select.twig' with {
                name: 'display_mode',
                label: 'Display',
                options: ['all', 'redacted', 'summarized'],
                selected: kingdom.displayMode,
                max_width: '28rem'
            } %}
            {{ ui.submit('Save') }}
        </form>
        <p class="mt-3 small text-body-secondary mb-0">Enrollment status: <span class="fw-semibold">{{ kingdom.enrollmentStatus }}</span></p>
        {% if kingdom.enrollmentStatus == 'disconnected' %}
            {% include 'components/alert.twig' with {
                variant: 'warning',
                message: 'Bank access was disconnected. Use Add bank below to connect again.'
            } %}
        {% endif %}
    {% endblock %}
{% endembed %}

{% embed 'components/section-card.twig' with { title: 'Bank connection' } %}
    {% import "macros.twig" as ui %}
    {% block section_body %}
        {% if not connect.available %}
            <form method="post" action="/manage/{{ kingdom.slug }}/connect">
                <input type="hidden" name="csrf" value="{{ csrf }}">
                {% for id in connect.skipped %}
                    <input type="hidden" name="skipped[]" value="{{ id }}">
                {% endfor %}
                {{ ui.submit('Add bank') }}
            </form>
            {% if connect.reason == 'exhausted' %}
                {% include 'components/alert.twig' with {
                    variant: 'warning',
                    message: 'No configured provider is available. Contact the Denarius administrator.'
                } %}
            {% endif %}
        {% else %}
            <div class="vstack gap-2">
                {% include 'connect/' ~ connect.provider ~ '.twig' %}
            </div>
            <form method="post" action="/manage/{{ kingdom.slug }}/connect" class="mt-3">
                <input type="hidden" name="csrf" value="{{ csrf }}">
                {% for id in connect.skipped %}
                    <input type="hidden" name="skipped[]" value="{{ id }}">
                {% endfor %}
                <input type="hidden" name="current" value="{{ connect.provider }}">
                <button type="submit" name="skip" value="1" class="btn btn-outline-secondary btn-sm">Try another provider</button>
            </form>
        {% endif %}
    {% endblock %}
{% endembed %}

<form id="enrollment-form" method="post" action="/manage/{{ kingdom.slug }}/enrollment" class="d-none">
    <input type="hidden" name="csrf" value="{{ csrf }}">
    <input type="hidden" name="enrollment" id="enrollment-json">
</form>

{% embed 'components/section-card.twig' with { title: 'Published accounts' } %}
    {% import "macros.twig" as ui %}
    {% block section_body %}
        <form method="post" action="/manage/{{ kingdom.slug }}/accounts">
            <input type="hidden" name="csrf" value="{{ csrf }}">
            <div class="vstack gap-2 mb-3">
            {% for account in accounts %}
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="published[]" value="{{ account.tellerAccountId }}" id="pub-{{ account.tellerAccountId }}" {% if account.published %}checked{% endif %}>
                    <label class="form-check-label" for="pub-{{ account.tellerAccountId }}">
                        {{ account.name }} ({{ account.type }})
                    </label>
                </div>
            {% endfor %}
            </div>
            {{ ui.submit('Save accounts') }}
        </form>
    {% endblock %}
{% endembed %}
{% endblock %}

{% block scripts %}
{% if connect.available %}
<script>
function denariusEnrollment(extra) {
    var payload = Object.assign({}, extra || {}, {
        provider: {{ connect.provider|json_encode|raw }}
    });
    document.getElementById('enrollment-json').value = JSON.stringify(payload);
    document.getElementById('enrollment-form').submit();
}
{% if connect.autostart %}
document.addEventListener('DOMContentLoaded', function () {
    var start = document.getElementById('teller-connect')
        || document.getElementById('plaid-connect')
        || document.getElementById('stripe-connect')
        || document.getElementById('simplefin-connect');
    if (start) {
        start.click();
    }
});
{% endif %}
</script>
{% endif %}
{% endblock %}
