{% extends "base.twig" %}
{% block title %}Manage {{ kingdom.name }}{% endblock %}
{% block body %}
<h1>Manage {{ kingdom.name }}</h1>
<p><a href="/{{ kingdom.slug }}">Public statement</a></p>
<form method="post" action="/manage/{{ kingdom.slug }}/settings">
    <input type="hidden" name="csrf" value="{{ csrf }}">
    <label>Visibility
        <select name="visibility">
            {% for value in ['public', 'registered', 'kingdom_only'] %}
                <option value="{{ value }}" {% if kingdom.visibility == value %}selected{% endif %}>{{ value }}</option>
            {% endfor %}
        </select>
    </label>
    <label>Display
        <select name="display_mode">
            {% for value in ['all', 'redacted', 'summarized'] %}
                <option value="{{ value }}" {% if kingdom.displayMode == value %}selected{% endif %}>{{ value }}</option>
            {% endfor %}
        </select>
    </label>
    <button type="submit">Save</button>
</form>
<p>Status: {{ kingdom.enrollmentStatus }}</p>
<form method="post" action="/manage/{{ kingdom.slug }}/connect" id="find-bank">
    <input type="hidden" name="csrf" value="{{ csrf }}">
    <label>Bank
        <input name="institution" value="{{ connect.institution }}" required>
    </label>
    {% for id in connect.skipped %}
        <input type="hidden" name="skipped[]" value="{{ id }}">
    {% endfor %}
    <button type="submit">Find my bank</button>
</form>
{% if connect.reason == 'institution' %}
    <p>Enter the bank name.</p>
{% elseif connect.reason == 'exhausted' %}
    <p>No configured provider can connect this bank.</p>
{% endif %}
{% if connect.available %}
    <script>
    function denariusEnrollment(extra) {
        var payload = Object.assign({}, extra || {}, {
            provider: {{ connect.provider|json_encode|raw }},
            institutionName: {{ connect.institution|json_encode|raw }}
        });
        document.getElementById('enrollment-json').value = JSON.stringify(payload);
        document.getElementById('enrollment-form').submit();
    }
    </script>
    {% include 'connect/' ~ connect.provider ~ '.twig' %}
    <form method="post" action="/manage/{{ kingdom.slug }}/connect" id="skip-bank">
        <input type="hidden" name="csrf" value="{{ csrf }}">
        <input type="hidden" name="institution" value="{{ connect.institution }}">
        {% for id in connect.skipped %}
            <input type="hidden" name="skipped[]" value="{{ id }}">
        {% endfor %}
        <input type="hidden" name="current" value="{{ connect.provider }}">
        <button type="submit" name="skip" value="1">My bank is not listed</button>
    </form>
{% endif %}
<form id="enrollment-form" method="post" action="/manage/{{ kingdom.slug }}/enrollment">
    <input type="hidden" name="csrf" value="{{ csrf }}">
    <input type="hidden" name="enrollment" id="enrollment-json">
</form>
<form method="post" action="/manage/{{ kingdom.slug }}/accounts">
    <input type="hidden" name="csrf" value="{{ csrf }}">
    {% for account in accounts %}
        <label>
            <input type="checkbox" name="published[]" value="{{ account.tellerAccountId }}" {% if account.published %}checked{% endif %}>
            {{ account.name }} ({{ account.type }})
        </label>
    {% endfor %}
    <button type="submit">Save accounts</button>
</form>
<form method="post" action="/manage/{{ kingdom.slug }}/refresh">
    <input type="hidden" name="csrf" value="{{ csrf }}">
    <button type="submit">Refresh transactions</button>
</form>
{% if kingdom.enrollmentStatus == 'disconnected' %}
    <p>Reconnect this kingdom from the bank form.</p>
{% endif %}
{% endblock %}
