{% extends "base.twig" %}
{% import "macros.twig" as ui %}

{% block title %}Manage {{ kingdom.name }}{% endblock %}
{% block container_class %}container-lg{% endblock %}

{% block content %}
{% embed 'components/page-header.twig' with { title: 'Manage ' ~ kingdom.name } %}
    {% import "macros.twig" as ui %}
    {% block header_actions %}
        <p class="mb-0 d-flex flex-wrap gap-2 align-items-center">
            {{ ui.btn_secondary('Public statement', '/' ~ kingdom.slug) }}
        </p>
    {% endblock %}
{% endembed %}

{% include 'manage/partials/tab-nav.twig' %}

{% if manageTab == 'settings' %}
    {% include 'manage/partials/tab-settings.twig' %}
{% elseif manageTab == 'patterns' %}
    {% include 'manage/partials/tab-patterns.twig' %}
{% else %}
    {% include 'manage/partials/tab-review.twig' %}
{% endif %}
{% endblock %}

{% block scripts %}
{% if manageTab == 'review' or manageTab == 'patterns' %}
<script src="/js/category-typeahead.js"></script>
{% endif %}
{% if manageTab == 'review' %}
<script src="/js/review-publication-checkboxes.js"></script>
<script src="/js/review-pattern-modal.js"></script>
{% if patternAutomaticCandidates|default([])|length > 0 %}
<script src="/js/pattern-automatic-review-modal.js"></script>
{% endif %}
{% endif %}
<script>
document.addEventListener('DOMContentLoaded', function () {
    if (typeof bootstrap === 'undefined') {
        return;
    }
    document.querySelectorAll('[data-bs-toggle="popover"]').forEach(function (trigger) {
        bootstrap.Popover.getOrCreateInstance(trigger);
    });
});
</script>
{% if manageTab == 'settings' and connect.available %}
<script>
function denariusEnrollment(extra) {
    var payload = Object.assign({}, extra || {}, {
        provider: {{ connect.provider|json_encode|raw }}
    });
    document.getElementById('enrollment-json').value = JSON.stringify(payload);
    document.getElementById('enrollment-form').submit();
}
{% if connect.autostart %}
document.addEventListener('DOMContentLoaded', function () {
    var start = document.getElementById('teller-connect')
        || document.getElementById('plaid-connect')
        || document.getElementById('stripe-connect')
        || document.getElementById('simplefin-connect');
    if (start) {
        start.click();
    }
});
{% endif %}
</script>
{% endif %}
{% endblock %}
