{% extends "base.twig" %}
{% import "macros.twig" as ui %}

{% block title %}Denarius admin{% endblock %}
{% block container_class %}container-lg{% endblock %}

{% block content %}
<h1 class="font-serif display-6 text-denarius-secondary mb-4">Roles</h1>
<form method="get" action="/admin" class="mb-4 row g-3 align-items-end" id="admin-principal-form">
    <input type="hidden" name="perm_email" value="{{ perm_email }}">
    <input type="hidden" name="perm_kingdom" value="{{ perm_kingdom }}">
    <div class="col-lg flex-grow-1 position-relative" style="min-width: 20rem;">
        <label for="admin-email" class="form-label fw-semibold text-denarius-tertiary">Email</label>
        <input
            id="admin-email"
            name="email"
            type="text"
            value="{{ email }}"
            autocomplete="off"
            class="form-control"
        >
        <ul id="admin-email-suggestions" class="admin-typeahead list-group position-absolute w-100 shadow-sm d-none" style="z-index: 10; max-height: 15rem; overflow-y: auto;" role="listbox"></ul>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Select</button>
    </div>
</form>
{% for principal in principals %}
    <section class="mb-4 pb-4 border-bottom">
        <h2 class="font-serif h4 text-denarius-tertiary mb-3">{{ principal.email }} <span class="small font-sans text-body-secondary">({{ principal.idpUserId }})</span></h2>
        <form method="post" action="/admin/grant" class="mb-3 d-flex flex-wrap gap-2">
            <input type="hidden" name="csrf" value="{{ csrf }}">
            <input type="hidden" name="idp_user_id" value="{{ principal.idpUserId }}">
            <input type="hidden" name="target_email" value="{{ principal.email }}">
            <button name="action" value="grant-admin" type="submit" class="btn btn-primary btn-sm">Grant admin</button>
            <button name="action" value="revoke-admin" type="submit" class="btn btn-outline-secondary btn-sm">Revoke admin</button>
        </form>
        <form method="post" action="/admin/grant" class="row g-3 align-items-end">
            <input type="hidden" name="csrf" value="{{ csrf }}">
            <input type="hidden" name="idp_user_id" value="{{ principal.idpUserId }}">
            <input type="hidden" name="target_email" value="{{ principal.email }}">
            <div class="col-auto">
                <label class="form-label fw-semibold text-denarius-tertiary">Kingdom
                    <select name="ork_kingdom_id" class="form-select ork-kingdom mt-1" style="min-width: 12rem;"></select>
                </label>
            </div>
            <p class="ork-kingdom-hint alert alert-warning d-none w-100 mb-0">
                No ORK kingdom directory is available yet. Denarius seeds from ORK (server or your browser) and falls back to the bundled snapshot when Cloudflare blocks the server.
            </p>
            <input type="hidden" name="kingdom_name" value="">
            <div class="col-auto d-flex flex-wrap gap-2">
                <button name="action" value="grant-manager" type="submit" class="btn btn-primary btn-sm">Grant kingdom manager</button>
                <button name="action" value="revoke-manager" type="submit" class="btn btn-outline-secondary btn-sm">Revoke kingdom manager</button>
            </div>
        </form>
    </section>
{% endfor %}

<section class="mt-5 pt-4 border-top">
    <h2 class="font-serif h3 text-denarius-secondary mb-4">Granted permissions</h2>
    <form method="get" action="/admin" class="mb-4 row g-3 align-items-end" id="admin-permissions-filter">
        <input type="hidden" name="email" value="{{ email }}">
        <div class="col-md">
            <label for="perm-email" class="form-label fw-semibold text-denarius-tertiary">Filter by email</label>
            <input
                id="perm-email"
                name="perm_email"
                type="text"
                value="{{ perm_email }}"
                autocomplete="off"
                class="form-control"
            >
        </div>
        <div class="col-md">
            <label for="perm-kingdom" class="form-label fw-semibold text-denarius-tertiary">Filter by kingdom</label>
            <input
                id="perm-kingdom"
                name="perm_kingdom"
                type="text"
                value="{{ perm_kingdom }}"
                autocomplete="off"
                class="form-control"
            >
        </div>
        <div class="col-auto d-flex flex-wrap align-items-center gap-2">
            <button type="submit" class="btn btn-primary">Filter</button>
            {% if perm_email or perm_kingdom %}
                <a href="/admin{% if email %}?email={{ email|url_encode }}{% endif %}" class="small">Clear filters</a>
            {% endif %}
        </div>
    </form>
    {% if grantedPermissions is empty %}
        <p class="text-body-secondary">No active grants match the current filters.</p>
    {% else %}
        <div class="table-responsive">
            <table class="table table-sm table-bordered table-striped align-middle">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Email</th>
                        <th scope="col">Permission</th>
                        <th scope="col">Kingdom</th>
                        <th scope="col">Granted</th>
                    </tr>
                </thead>
                <tbody>
                {% for row in grantedPermissions %}
                    <tr>
                        <td>
                            {% if row.email %}
                                {{ row.email }}<span class="d-block small text-body-secondary">{{ row.idpUserId }}</span>
                            {% else %}
                                <span class="text-body-secondary">{{ row.idpUserId }}</span>
                            {% endif %}
                        </td>
                        <td>{{ row.permission }}</td>
                        <td>{{ row.kingdomName }}</td>
                        <td>{{ row.grantedAt }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</section>
{% endblock %}

{% block scripts %}
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script>
jQuery(function ($) {
    var orkApiBase = {{ ork_api_base_url|json_encode|raw }};
    var csrfToken = {{ csrf|json_encode|raw }};

    function fillKingdomSelects(kingdoms) {
        $('.ork-kingdom').empty();
        if (!kingdoms.length) {
            $('.ork-kingdom-hint').removeClass('d-none');
            return;
        }
        $('.ork-kingdom-hint').addClass('d-none');
        kingdoms.forEach(function (kingdom) {
            $('select.ork-kingdom').append(
                $('<option>').val(String(kingdom.id)).text(kingdom.name)
            );
        });
    }

    function fetchOrkFromBrowser() {
        var url = String(orkApiBase).replace(/\/$/, '') + '/orkservice/Json/index.php?request=';
        return fetch(url, {
            method: 'POST',
            headers: {'Content-Type': 'application/x-www-form-urlencoded'},
            body: 'call=Kingdom/GetKingdoms&request=' + encodeURIComponent('{}'),
            credentials: 'include',
        }).then(function (response) {
            return response.text();
        });
    }

    function syncOrkJson(raw) {
        return $.ajax({
            url: '/admin/kingdoms/sync',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({csrf: csrfToken, ork_json: raw}),
        });
    }

    function loadKingdoms() {
        $.getJSON('/admin/kingdoms').done(function (payload) {
            var kingdoms = payload.kingdoms || [];
            if (kingdoms.length) {
                fillKingdomSelects(kingdoms);
                return;
            }
            fetchOrkFromBrowser()
                .then(function (raw) { return syncOrkJson(raw); })
                .done(function (synced) {
                    fillKingdomSelects(synced.kingdoms || []);
                })
                .fail(function () {
                    fillKingdomSelects([]);
                });
        });
    }

    loadKingdoms();

    var suggestTimer = null;
    var $email = $('#admin-email');
    var $list = $('#admin-email-suggestions');

    function hideSuggestions() {
        $list.addClass('d-none').empty();
    }

    function showSuggestions(items) {
        $list.empty();
        if (!items.length) {
            hideSuggestions();
            return;
        }
        items.forEach(function (item) {
            var $li = $('<li>', {
                class: 'list-group-item list-group-item-action small',
                role: 'option',
                text: item.email + ' (' + item.idpUserId + ')'
            });
            $li.data('email', item.email);
            $list.append($li);
        });
        $list.removeClass('d-none');
    }

    $email.on('input', function () {
        window.clearTimeout(suggestTimer);
        var q = $email.val().trim();
        if (q.length < 2) {
            hideSuggestions();
            return;
        }
        suggestTimer = window.setTimeout(function () {
            $.getJSON('/admin/principal-suggestions', { q: q })
                .done(function (payload) {
                    showSuggestions(payload.suggestions || []);
                });
        }, 200);
    });

    $list.on('click', 'li', function () {
        $email.val($(this).data('email'));
        hideSuggestions();
    });

    $(document).on('click', function (event) {
        if (!$(event.target).closest('#admin-principal-form').length) {
            hideSuggestions();
        }
    });

    $(document).on('submit', 'form', function () {
        var select = $(this).find('select.ork-kingdom');
        if (select.length === 0) {
            return;
        }
        $(this).find('input[name="kingdom_name"]').val(select.find('option:selected').text());
    });
});
</script>
{% endblock %}
